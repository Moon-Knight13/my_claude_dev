# EDITING THIS FILE: change a line in place. Do not append a second copy of a key
# you have already set above — it is confusing to read, and on an older checkout
# the first assignment silently won and the appended one did nothing.

# ── Container firewall ───────────────────────────────────────────────────────
# Controls devcontainer egress filtering (init-firewall.sh).
#   strict     — deny-by-default, only GitHub + Anthropic + spokes (production)
#   permissive — allow all outbound, container isolation still active (debug)
# Use permissive TEMPORARILY to prove spoke/MCP connectivity, then revert.
FIREWALL_MODE=strict

# ── Local model (failover) ────────────────────────────────────────────────────
# Opus 4.6 is the primary model (via Claude Code subscription). The local model
# is failover only: used when the primary is unavailable.
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_ENDPOINT=http://host.docker.internal:11434
LOCAL_MODEL_MODEL=qwen2.5-coder:7b

# Optional feature toggles
CAVEMAN_ENABLED=1
CAVEMAN_MODE=lite
BMAD_ENABLED=1

# ── GitHub auth ───────────────────────────────────────────────────────────────
# Do NOT put a GitHub token here (or in any env var / repo file). Authenticate
# in the container terminal with browser OAuth instead:
#   gh auth login --hostname github.com --git-protocol https --web
# The token lands in gh's config (a named volume outside the workspace), git
# uses it via gh's credential helper, and nothing is readable from the repo.

# ── Spoke connectivity ────────────────────────────────────────────────────────
# Spokes are range systems reached from the devcontainer. The host must have
# an SSH server enabled and VPN connected to the range.
# Run scripts/local/bootstrap-hub.sh on the host BEFORE launching the container.
#
# spoke-firewall.sh adds these IPs to the container firewall allow-list at
# startup and on /mode switch. IPs preferred; hostnames resolved via DNS.
# These values also populate ~/.ssh/config (via setup-container-ssh.sh).
# Do NOT put passwords or private keys here — SSH agent forwarding handles auth.
# Do NOT put tokens or secrets here — this file is read by setup scripts only.

# Hub — your host username for ProxyJump (required for spoke connectivity)
HUB_SSH_USER=

# Deploy box — catapult, ansible deploys, ctp-bridge target
SPOKE_DEPLOYBOX_HOST=
SPOKE_DEPLOYBOX_USER=gt
SPOKE_DEPLOYBOX_PORT=22

# Kali spoke — all offensive operations route through this box
# Shell access, C2 (Tuoni), visual access (RDP/VNC via SOCKS), tools
SPOKE_KALI_HOST=
SPOKE_KALI_USER=rt
SPOKE_KALI_SSH_PORT=22
SPOKE_KALI_C2_API_PORT=12702
SPOKE_KALI_C2_WEB_PORT=8443
SPOKE_KALI_SOCKS_PORT=1080

# ── Range git ─────────────────────────────────────────────────────────────────
# GitLab on the range
RANGE_GIT_HOST=
RANGE_GIT_SSH_PORT=10022
RANGE_GIT_USER=git

# ── Range services ───────────────────────────────────────────────────────────
# IP or hostname of range services. spoke-firewall.sh adds these to the
# container firewall allow-list (allowed-domains ipset) at startup and on
# /mode switch. IPs preferred; hostnames resolved via DNS at add time.
PROVIDENTIA_HOST=
OUTLINE_HOST=

# ── Obsidian vault ────────────────────────────────────────────────────────────
# Local path on HOST to the Obsidian vault. Mounted into container as a volume.
# Used by Obsidian MCP for engagement docs, tactical notes, LLM wiki.
OBSIDIAN_VAULT_PATH=~/Documents/my_notes

# ── MCP SSE proxy ─────────────────────────────────────────────────────────────
# Bearer token for authenticating container-to-host MCP SSE proxy connections.
# Required when devcontainer uses bridge networking (the default).
# Generate with: openssl rand -hex 32
# The host proxy (scripts/host/start-mcp-proxies.sh) and container both read
# this from .env — they share the same secret.
MCP_PROXY_TOKEN=

# ── MCP credentials ───────────────────────────────────────────────────────────
# load-env.sh derives MCP server URLs automatically from *_HOST vars above:
#   PROVIDENTIA_HOST  ->  PROVIDENTIA_URL   (https://<host>)
#   OUTLINE_HOST      ->  OUTLINE_API_URL   (https://<host>)
#   RANGE_GIT_HOST    ->  GITLAB_URL        (https://<host>)
#   SPOKE_KALI_HOST   ->  TUONI_URL         (https://<host>:<C2_WEB_PORT>)
#
# Do NOT set URL vars here — they are auto-derived. Only override if you need
# a non-standard scheme or port.
#
# Only credentials below. .env is gitignored — never committed.

# Tuoni C2 (shell-dot/tuoni-mcp — HTTP Basic Auth)
TUONI_USERNAME=
TUONI_PASSWORD=

# Providentia CMDB (range-intel MCP)
PROVIDENTIA_TOKEN=

# GitLab REST API (range-intel MCP)
GITLAB_TOKEN=
GITLAB_PROJECT=

# Outline wiki (outline-readonly MCP)
OUTLINE_API_KEY=

# ── BloodHound CE (bloodhound-mcp) ────────────────────────────────────────
# Neo4j bolt endpoint for BloodHound CE graph on Kali spoke.
# BloodHound CE ships its own Neo4j — default creds below.
BLOODHOUND_URI=bolt://<KALI_HOST>:7687
BLOODHOUND_USERNAME=neo4j
BLOODHOUND_PASSWORD=<change-me>

# ── Hashcat MCP (hashcat-mcp) ────────────────────────────────────────────
# Hashcat binary runs on Kali spoke via SSH wrapper; MCP proxies locally.
HASHCAT_PATH=/usr/bin/hashcat
HASHCAT_MCP_HOST=<KALI_HOST>
HASHCAT_MCP_PORT=8080

# ── Nuclei MCP (nuclei-mcp) ──────────────────────────────────────────────
# Nuclei scanner binary — auto-downloads if missing at install time.
NUCLEI_PATH=/usr/bin/nuclei

# ── GhidraMCP (ghidra-mcp) ──────────────────────────────────────────────
# Ghidra headless analysis backend for ghidra-mcp. Set by install-ghidra-backend.sh.
GHIDRA_INSTALL_DIR=~/.local/share/ghidra/ghidra_12.1.4_PUBLIC
JAVA_HOME=~/.local/share/ghidra/jdk-21.0.7+6

# ── Guard configuration ──────────────────────────────────────────────────
# Agent safety guards. On host, these are the single source of truth.
# On remote boxes, config files (~/.ctp-bridge.conf etc.) still work and
# these vars override them when set.
#
# Secret paths: denied to all agent tools (Read/Write/Edit/Bash).
# Space-separated globs. ~/ expands to $HOME. **/ matches any directory.
GUARD_SECRET_PATHS=~/.ssh/id_* **/.env ~/.gnupg/**

# Org PII/IP paths: denied to agent tools. Opt-in — list directories
# where sensitive data lives. Empty = no PII guard active.
GUARD_PII_PATHS=

# Destructive-action allowlist: exempt specific verbs from confirmation.
# Empty = all destructive ops require human confirmation (recommended).
GUARD_SAFETY_ALLOWLIST=

# Destructive-git allowlist: exempt specific git ops from confirmation.
# Empty = all destructive git ops require human confirmation (recommended).
GUARD_GIT_ALLOWLIST=
