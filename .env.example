# EDITING THIS FILE: change a line in place. Do not append a second copy of a key
# you have already set above — it is confusing to read, and on an older checkout
# the first assignment silently won and the appended one did nothing.
#
# Model routing
LOCAL_MODEL_ENABLED=true
# The endpoint differs by surface, and getting it wrong is silent — every task
# just routes to Claude with reason local_unreachable_fallback.
#   your own host: http://localhost:11434            (the model runs on this
#                 machine — the case when you run the tooling directly rather
#                 than in a container)
#   devcontainer: http://host.docker.internal:11434  (the model runs on your host)
#   remote box:   http://127.0.0.1:11434             (the model runs on your LAPTOP
#                 and arrives over the reverse tunnel the laptop bootstrap writes
#                 into your SSH Host block; use the box-side port you chose there)
# Do NOT bind the model to 0.0.0.0 to make a box reach it — that publishes a
# personal machine's model onto the network the box sits on. Use the tunnel.
#
# The value below is the DEVCONTAINER one, because that is where this template is
# usually first run. Running on a host? Change it to localhost. The orchestrator's
# sensitivity classifier also reads it, and if it cannot reach a model it fails
# closed and calls every prompt sensitive — safe, and quietly useless.
LOCAL_MODEL_ENDPOINT=http://host.docker.internal:11434
LOCAL_MODEL_MODEL=qwen2.5-coder:7b
# Instruct-tuned. Do NOT use a ":*-base" model here: base models are not
# instruction-tuned, so they continue your prompt instead of answering it, and
# the result is fluent enough to pass the output sanity checks.
LOCAL_MODEL_FAST_MODEL=qwen2.5-coder:1.5b
LOCAL_MODEL_FAST_TASK_TYPES=format,docs,tiny-refactor,rename,simple-test
CLAUDE_MODEL=claude-sonnet-4-6
FORCE_CLAUDE=false
FORCE_LOCAL=false
MODEL_ROUTE_LOG=.ai/route-log.jsonl

# Delegation lifecycle (scripts/delegate-local.sh + scripts/local-health.sh)
LOCAL_MODEL_TIMEOUT=120        # hard cap (s) per local generation before escalating
LOCAL_MODEL_MAX_OUTPUT=2048    # num_predict cap per local generation
LOCAL_MODEL_MIN_TPS=5          # tokens/sec floor; slower marks the model degraded
LOCAL_HEALTH_CACHE=.ai/local-health.json
LOCAL_HEALTH_TTL=300           # seconds a health probe stays valid
LOCAL_MODEL_PROBE_TIMEOUT=45   # max seconds for the health speed probe

# ── Local-model orchestrator (G3) ─────────────────────────────────────────────
# Only needed if you use scripts/orchestrator/. The model registry lives in
# ~/.config/orchestrator.conf (a different thing from ~/.config/orchestrator/,
# which holds your private term list and prompts). Full setup:
# docs/ORCHESTRATOR.md.
#
# ORCH_CLASSIFIER turns AUTO classification on. UNTIL IT IS SET, AUTO treats every
# prompt as sensitive and nothing ever routes to the cloud — the fail-closed
# default, working as intended and easy to mistake for a broken setup. It must be
# an ABSOLUTE path; it is executed directly, so a relative one breaks outside the
# repo root.
# ORCH_CLASSIFIER=/absolute/path/to/scripts/orchestrator/classify-sensitivity.sh
# ORCH_CLASSIFIER_TIMEOUT=20     # raise it if a cold model load exceeds this
# ORCH_CLASSIFIER_KEEP_ALIVE=30m # keep the judge resident between prompts
#
# Optional: the cloud-handoff sanitiser (defense-in-depth, not the gate).
# ORCH_SANITISER=/absolute/path/to/scripts/orchestrator/sanitise.sh
#
# Your private word list. The default path is already correct; set this only if
# you keep it elsewhere. A listed word forces `sensitive` in every mode.
# ORCH_TERM_LIST=~/.config/orchestrator/term-list.txt
#
# The executor (orchestrate.sh --tools) — see .orchestrator.conf.example for the
# full set. These are the two worth knowing about:
# ORCH_EXEC_MAX_STEPS=12         # bounds any single run, injected or not
# ORCH_CALLER=human              # who is on the other end, so what may be returned

# Optional feature toggles
CAVEMAN_ENABLED=1
CAVEMAN_MODE=lite
BMAD_ENABLED=1

# ── GitHub auth ───────────────────────────────────────────────────────────────
# Do NOT put a GitHub token here (or in any env var / repo file). Authenticate
# in the container terminal with browser OAuth instead:
#   gh auth login --hostname github.com --git-protocol https --web
# The token lands in gh's config (a named volume outside the workspace), git
# uses it via gh's credential helper, and nothing is readable from the repo.
