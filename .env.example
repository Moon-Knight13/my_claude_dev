# EDITING THIS FILE: change a line in place. Do not append a second copy of a key
# you have already set above — it is confusing to read, and on an older checkout
# the first assignment silently won and the appended one did nothing.

# ── Local model (failover) ────────────────────────────────────────────────────
# Opus 4.6 is the primary model (via Claude Code subscription). The local model
# is failover only: used when the primary is unavailable.
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_ENDPOINT=http://host.docker.internal:11434
LOCAL_MODEL_MODEL=qwen2.5-coder:7b

# Optional feature toggles
CAVEMAN_ENABLED=1
CAVEMAN_MODE=lite
BMAD_ENABLED=1

# ── GitHub auth ───────────────────────────────────────────────────────────────
# Do NOT put a GitHub token here (or in any env var / repo file). Authenticate
# in the container terminal with browser OAuth instead:
#   gh auth login --hostname github.com --git-protocol https --web
# The token lands in gh's config (a named volume outside the workspace), git
# uses it via gh's credential helper, and nothing is readable from the repo.

# ── Spoke connectivity ────────────────────────────────────────────────────────
# Spokes are range systems reached from the devcontainer via SSH ProxyJump
# through the host. The host must have an SSH server enabled and VPN connected.
# Run scripts/local/bootstrap-hub.sh on the host BEFORE launching the container.
#
# These values populate ~/.ssh/config inside the container at setup time
# (via scripts/setup-container-ssh.sh, called from project-setup.sh).
# Do NOT put passwords or private keys here — SSH agent forwarding handles auth.
# Do NOT put tokens or secrets here — this file is read by setup scripts only.

# Hub — your host username for ProxyJump (required for spoke connectivity)
HUB_SSH_USER=

# Deploy box — catapult, ansible deploys, ctp-bridge target
SPOKE_DEPLOYBOX_HOST=
SPOKE_DEPLOYBOX_USER=gt
SPOKE_DEPLOYBOX_PORT=22

# Kali spoke — all offensive operations route through this box
# Shell access, C2 (Tuoni), visual access (RDP/VNC via SOCKS), tools
SPOKE_KALI_HOST=
SPOKE_KALI_USER=root
SPOKE_KALI_SSH_PORT=22
SPOKE_KALI_C2_API_PORT=12702
SPOKE_KALI_C2_WEB_PORT=8443
SPOKE_KALI_SOCKS_PORT=1080

# ── Range git ─────────────────────────────────────────────────────────────────
# GitLab on the range (accessed via deploy box spoke, not directly from container)
RANGE_GIT_HOST=
RANGE_GIT_SSH_PORT=10022
RANGE_GIT_USER=

# ── Obsidian vault ────────────────────────────────────────────────────────────
# Local path on HOST to the Obsidian vault. Mounted into container as a volume.
# Used by Obsidian MCP for engagement docs, tactical notes, LLM wiki.
OBSIDIAN_VAULT_PATH=~/Documents/my_notes

# ── MCP credentials ───────────────────────────────────────────────────────────
# MCP servers that need auth (tuoni-mcp, range-intel, etc.) read credentials
# from mounted secrets files, NOT from env vars. Connection endpoints are
# derived from SPOKE_C2_* vars above. See docs for secrets mounting pattern.
