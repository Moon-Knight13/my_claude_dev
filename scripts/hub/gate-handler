#!/usr/bin/env bash
# gate-handler — one connection to the gate's hub socket (SP1a story 2.3;
# AD-1, AD-2, AD-3, AD-20, FR-4, FR-5, FR-10, FR-11, NFR-6).
#
# systemd socket activation (gate-hub.socket, Accept=yes) starts one handler per
# connection under the gate identity, with the connected socket as stdin and
# stdout. The handler:
#   1. refuses a peer that is not the operator or a hub service identity;
#   2. reads ONE request: one header line (at most 4096 bytes), then raw payload
#      bytes until the client half-closes, at most GATE_MAX_REQUEST bytes;
#   3. decides in a child process bounded by GATE_DEADLINE (a bulk eval with a
#      manifest: GATE_EVAL_BUDGET); ops: eval, health (scripts/lib/gate-health.sh);
#   4. answers ONE line and exits, which closes the connection.
# Every fault answers block. Nothing it prints names a term.
#
#   gate-handler <config dir>                  serve the connection on stdin/stdout
#   gate-handler --check-config <config dir>   validate GATE_ config; exit 0 or 4
#                                              (ExecStartPre of gate-hub.socket:
#                                              invalid deadlines stop the gate)
#
# Response: {"v":1,"verdict":"allow"} or {"v":1,"verdict":"block","ref":"gr-…"},
# plus "detail" (reason, per-layer results) — on this hub socket only.
#
# Config: <config dir>/lane2.conf (LANE2_OPERATOR, LANE2_PREFIX,
# LANE2_STATE_ROOT), gate.conf (GATE_*), fleet.conf (the classifier member).
# The config dir is the unit's argument; nothing is read from the environment.
#
# No `set -e`: the handler must answer whatever happens.
set -uo pipefail

GATE_HANDLER="$(readlink -f "${BASH_SOURCE[0]}")"
GATE_HERE="$(dirname "$GATE_HANDLER")"
# shellcheck source=scripts/lib/lane2.sh
source "$GATE_HERE/../lib/lane2.sh"
# shellcheck source=scripts/lib/gate.sh
source "$GATE_HERE/../lib/gate.sh"
# shellcheck source=scripts/lib/gate-health.sh
source "$GATE_HERE/../lib/gate-health.sh"
# shellcheck source=scripts/lib/gate-store.sh
source "$GATE_HERE/../lib/gate-store.sh"

GATE_HEADER_MAX=4096
GATE_CONTAINER_OPS=(prompt expansion tool_input tool_result)
GATE_PENDING_OPS=(push git_text mount_scan rescan)   # later stories

# --- config ------------------------------------------------------------------

gate_load() { # gate_load <confdir> — rc 4 on any unusable value
    local d="$1"
    [[ "$d" == /* ]] || return 4
    lane2_load_config "$d/lane2.conf" || return 4
    GATE_OPERATOR="$(lane2_conf LANE2_OPERATOR)"
    GATE_PREFIX="$(lane2_conf LANE2_PREFIX /opt/lane2)"
    GATE_STATE="$(lane2_conf LANE2_STATE_ROOT /var/lib/lane2)"
    GATE_FLEET_CONF="$d/fleet.conf"
    GATE_MAX_REQUEST="$(lane2_conf_file_get "$d/gate.conf" GATE_MAX_REQUEST)"; GATE_MAX_REQUEST="${GATE_MAX_REQUEST:-1048576}"
    GATE_DEADLINE="$(lane2_conf_file_get "$d/gate.conf" GATE_DEADLINE)"; GATE_DEADLINE="${GATE_DEADLINE:-25}"
    GATE_SHIM_TIMEOUT="$(lane2_conf_file_get "$d/gate.conf" GATE_SHIM_TIMEOUT)"; GATE_SHIM_TIMEOUT="${GATE_SHIM_TIMEOUT:-28}"
    GATE_HOOK_TIMEOUT="$(lane2_conf_file_get "$d/gate.conf" GATE_HOOK_TIMEOUT)"; GATE_HOOK_TIMEOUT="${GATE_HOOK_TIMEOUT:-30}"
    GATE_RETAIN_DAYS="$(lane2_conf_file_get "$d/gate.conf" GATE_RETAIN_DAYS)"; GATE_RETAIN_DAYS="${GATE_RETAIN_DAYS:-7}"
    GATE_STORE_MAX_BYTES="$(lane2_conf_file_get "$d/gate.conf" GATE_STORE_MAX_BYTES)"; GATE_STORE_MAX_BYTES="${GATE_STORE_MAX_BYTES:-268435456}"
    GATE_QUOTA_OPERATOR_BYTES="$(lane2_conf_file_get "$d/gate.conf" GATE_QUOTA_OPERATOR_BYTES)"; GATE_QUOTA_OPERATOR_BYTES="${GATE_QUOTA_OPERATOR_BYTES:-67108864}"
    GATE_QUOTA_CONTAINER_BYTES="$(lane2_conf_file_get "$d/gate.conf" GATE_QUOTA_CONTAINER_BYTES)"; GATE_QUOTA_CONTAINER_BYTES="${GATE_QUOTA_CONTAINER_BYTES:-201326592}"
    [[ -n "$GATE_OPERATOR" ]] || return 4
    [[ "$GATE_MAX_REQUEST" =~ ^[1-9][0-9]{0,9}$ ]] || return 4
    gate_check_deadlines "$GATE_DEADLINE" "$GATE_SHIM_TIMEOUT" "$GATE_HOOK_TIMEOUT" || return 4
    gate_load_budget "$d/gate.conf" "$GATE_DEADLINE" || return 4
    # Retention: 1..30 whole days and positive byte bounds, or the gate does not
    # start. Never clamped.
    gate_store_check_config "$GATE_RETAIN_DAYS" "$GATE_STORE_MAX_BYTES" \
        "$GATE_QUOTA_OPERATOR_BYTES" "$GATE_QUOTA_CONTAINER_BYTES" || return 4
    gate_store_init "$GATE_STATE"
    # Per-peer rate limit and probe budget (Story 2.5): requests and blocks per
    # window. Invalid values stop the gate.
    GATE_RATE_LIMIT="$(lane2_conf_file_get "$d/gate.conf" GATE_RATE_LIMIT)"; GATE_RATE_LIMIT="${GATE_RATE_LIMIT:-600}"
    GATE_RATE_WINDOW="$(lane2_conf_file_get "$d/gate.conf" GATE_RATE_WINDOW)"; GATE_RATE_WINDOW="${GATE_RATE_WINDOW:-60}"
    GATE_PROBE_BUDGET="$(lane2_conf_file_get "$d/gate.conf" GATE_PROBE_BUDGET)"; GATE_PROBE_BUDGET="${GATE_PROBE_BUDGET:-100}"
    gate_rate_check_config "$GATE_RATE_LIMIT" "$GATE_RATE_WINDOW" "$GATE_PROBE_BUDGET" || return 4
    gate_cache_init "$GATE_STATE"
    # Chunked classification (Story 2.7): chunk size in characters, overlap, and
    # the most chunks one request may take. Invalid values stop the gate.
    local v
    v="$(lane2_conf_file_get "$d/gate.conf" GATE_CHUNK_CHARS)"; GATE_CHUNK_CHARS="${v:-$GATE_CHUNK_CHARS}"
    v="$(lane2_conf_file_get "$d/gate.conf" GATE_CHUNK_OVERLAP)"; GATE_CHUNK_OVERLAP="${v:-$GATE_CHUNK_OVERLAP}"
    v="$(lane2_conf_file_get "$d/gate.conf" GATE_CHUNK_BUDGET)"; GATE_CHUNK_BUDGET="${v:-$GATE_CHUNK_BUDGET}"
    [[ "$GATE_CHUNK_CHARS" =~ ^[1-9][0-9]{2,5}$ && "$GATE_CHUNK_OVERLAP" =~ ^[0-9]{1,5}$ \
       && "$GATE_CHUNK_BUDGET" =~ ^[1-9][0-9]?$ ]] || return 4
    (( GATE_CHUNK_CHARS >= 500 && GATE_CHUNK_CHARS <= 64000 && GATE_CHUNK_OVERLAP * 4 <= GATE_CHUNK_CHARS )) || return 4
}

# --- peer --------------------------------------------------------------------

# The connecting process's uid, from SO_PEERCRED on the socket on stdin. bash
# cannot read socket options; perl (perl-base, essential on Ubuntu) can.
gate_peer_uid() {
    perl -MSocket -e '
        my $c = getsockopt(STDIN, SOL_SOCKET, SO_PEERCRED) or exit 1;
        my ($pid, $uid, $gid) = unpack("lll", $c); print $uid;' 2>/dev/null
}

gate_peer_allowed() { # gate_peer_allowed <uid>
    local uid="$1" n u
    [[ "$uid" =~ ^[0-9]+$ ]] || return 1
    u="$(getent passwd "$GATE_OPERATOR" | cut -d: -f3)"
    [[ -n "$u" && "$uid" == "$u" ]] && return 0
    for n in "${LANE2_SERVICE_IDENTITIES[@]}"; do
        u="$(getent passwd "$n" | cut -d: -f3)"
        [[ -n "$u" && "$uid" == "$u" ]] && return 0
    done
    return 1
}

# --- answer ------------------------------------------------------------------

gate_ref() { gate_new_ref 2>/dev/null || printf 'gr-%s' "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"; }

GATE_ANSWERED=""
# gate_answer allow [detail]                     an allow
# gate_answer block <reason> [detail] [ref]      an eval/health block: detail has
#                                                the reason and per-layer results
# gate_answer opaque <reason category> <ref>     any other block: the hub-socket
#                                                detail holds only reason_category
# The answer's verdict and ref, for the query log and the probe budget.
GATE_LAST_VERDICT=""; GATE_LAST_REF=""
gate_answer() {
    [[ -z "$GATE_ANSWERED" ]] || return 0
    GATE_ANSWERED=1
    case "$1" in
        allow)
            local d="${2:-}"; [[ -n "$d" ]] || d='{}'
            GATE_LAST_VERDICT=allow
            jq -nc --argjson d "$d" '{v: 1, verdict: "allow"} + (if $d == {} then {} else {detail: $d} end)' ;;
        opaque)
            GATE_LAST_VERDICT=block; GATE_LAST_REF="$3"
            jq -nc --arg ref "$3" --arg c "$2" '{v: 1, verdict: "block", ref: $ref, detail: {reason_category: $c}}' ;;
        *)
            local d="${3:-}" ref="${4:-}"; [[ -n "$d" ]] || d='{}'; [[ -n "$ref" ]] || ref="$(gate_ref)"
            GATE_LAST_VERDICT=block; GATE_LAST_REF="$ref"
            jq -nc --arg ref "$ref" --arg r "$2" --argjson d "$d" \
                '{v: 1, verdict: "block", ref: $ref, detail: ({reason: $r} + $d)}' ;;
    esac
}

# What a container caller receives for a block (the per-session sockets, Epic 4):
# v, verdict, and the ref — nothing else.
gate_container_answer() { jq -nc --arg ref "$1" '{v: 1, verdict: "block", ref: $ref}'; }

# A block on any op but eval or health: a fresh ref, the payload retained when
# one was read, one operator log line, and an opaque answer.
gate_block_record() { # gate_block_record <op> <reason> <payload file or "">
    local op="$1" cat="$2" payload="$3" origin ref
    op="$(gate_op_name "$op")"; origin="$(gate_op_origin "$op")"
    ref="$(gate_ref)"
    if [[ -n "$payload" && -f "$payload" ]]; then
        gate_retain "$ref" "$payload" "$origin" 2>/dev/null || cat="fault:store"
    fi
    gate_oplog "$op" "$origin" "$cat" "$ref" 2>/dev/null || true
    gate_answer opaque "$cat" "$ref"
}

# --- the work (child, bounded by the deadline) -------------------------------

# The work's result: verdict, reason, detail, the op (a known name or "unknown",
# never the caller's string), and whether $t/payload holds a payload to retain.
GATE_R_OP=unknown
GATE_R_PAYLOAD=0
gate_result() { # gate_result <dir> <allow|block> <reason> [detail json]
    local d="${4:-}"; [[ -n "$d" ]] || d='{}'
    jq -nc --arg v "$2" --arg r "$3" --argjson d "$d" --arg op "$GATE_R_OP" --argjson p "$GATE_R_PAYLOAD" \
        '{verdict: $v, reason: $r, detail: $d, op: $op, payload: ($p == 1)}' > "$1/result.tmp" \
        && mv -f "$1/result.tmp" "$1/result"
    exit 0
}

# Payload until half-close, bounded; over the limit is a block, never truncated.
gate_read_payload() { # gate_read_payload <dir>
    local size
    head -c "$(( GATE_MAX_REQUEST + 1 ))" > "$1/payload"
    size="$(wc -c < "$1/payload" | tr -d ' ')"
    (( size <= GATE_MAX_REQUEST )) || { rm -f -- "$1/payload"; gate_result "$1" block fault:oversize; }
    GATE_R_PAYLOAD=1
}

gate_work() { # gate_work <confdir> <tmpdir> — reads the request from stdin
    local conf="$1" t="$2" line op layers rc
    gate_load "$conf" || gate_result "$t" block fault:config
    export LC_ALL=C
    gate_watchdog_arm "$GATE_DEADLINE" "$t"

    # one header line, bounded
    IFS= read -r -n "$GATE_HEADER_MAX" line || gate_result "$t" block fault:protocol
    (( ${#line} < GATE_HEADER_MAX )) || gate_result "$t" block fault:protocol
    printf '%s' "$line" > "$t/header"
    jq -e 'type == "object" and (.v | type) == "number" and .v == 1 and (.op | type) == "string"' \
        "$t/header" >/dev/null 2>&1 || gate_result "$t" block fault:protocol
    op="$(jq -r .op "$t/header")"
    GATE_R_OP="$(gate_op_name "$op")"
    local o
    for o in "${GATE_CONTAINER_OPS[@]}" "${GATE_PENDING_OPS[@]}"; do
        if [[ "$op" == "$o" ]]; then
            # Known op not served here (yet): keep what it carried for review.
            [[ "$op" == health ]] || gate_read_payload "$t"
            gate_result "$t" block fault:protocol
        fi
    done
    [[ "$op" == eval || "$op" == health ]] || gate_result "$t" block fault:protocol
    gate_header_ok "$t/header" "$op" || gate_result "$t" block fault:protocol
    layers="$(jq -r '.layers // [] | join(" ")' "$t/header")"
    # eval and health measure the classifier itself: never from or into the cache.
    GATE_CACHE_BYPASS=1

    gate_read_payload "$t"
    local size; size="$(wc -c < "$t/payload" | tr -d ' ')"
    gate_is_text "$t/payload" || gate_result "$t" block fault:non-text

    # the policy, strictly; and policy_version must compute (AD-19)
    gate_policy_load "$GATE_STATE/gate-policy" "$GATE_OPERATOR" || gate_result "$t" block fault:policy
    local model sha build digest pv
    model="$(lane2_conf_file_get "$GATE_FLEET_CONF" FLEET_CLASSIFIER_MODEL)"
    sha="$(lane2_conf_file_get "$GATE_FLEET_CONF" FLEET_CLASSIFIER_SHA256 | tr 'A-F' 'a-f')"
    build="$(lane2_conf_file_get "$GATE_FLEET_CONF" FLEET_RUNTIME_BUILD)"
    [[ -d "$GATE_PREFIX/current" ]] || gate_result "$t" block fault:policy
    digest="$(lane2_tree_digest "$GATE_PREFIX/current" "${LANE2_GATE_CODE[@]}")"
    pv="$(gate_policy_version "$GATE_TERM_FILE" "$GATE_PROMPT_FILE" "$model" "$sha" "$build" "$digest")" \
        || gate_result "$t" block fault:policy

    # --- health op and bulk eval (story 2.6; scripts/lib/gate-health.sh) ------
    # Neither writes a cache entry, a retained payload, or an operator log line.
    if [[ "$op" == health ]]; then
        (( size == 0 )) || gate_result "$t" block fault:protocol
        gate_health_probes "$GATE_STATE/gate-policy/current" "$GATE_FLEET_CONF"
        gate_result "$t" "$GATE_HEALTH_VERDICT" "$GATE_HEALTH_REASON" "$GATE_HEALTH_DETAIL"
    fi
    if jq -e 'has("manifest")' "$t/header" >/dev/null 2>&1; then
        (( size == 0 )) || gate_result "$t" block fault:protocol
        # The caller states the policy_version it expects; a mismatch is a block,
        # and the gate's own value is never sent back.
        [[ "$(jq -r .policy_version "$t/header")" == "$pv" ]] || gate_result "$t" block fault:policy
        gate_watchdog_disarm      # a bulk eval runs to GATE_EVAL_BUDGET instead
        gate_eval_manifest "$(jq -r .manifest "$t/header")" "$GATE_STATE" "$layers" "$GATE_FLEET_CONF" \
            || gate_result "$t" block fault:protocol
        gate_result "$t" "$GATE_EVAL_VERDICT" "$GATE_EVAL_REASON" \
            "$(jq -nc --arg c "$GATE_EVAL_CODES" --argjson i "$(gate_eval_inputs)" '{cases: $c, inputs: $i}')"
    fi

    # eval: each requested layer, reported on its own; no cache, no log
    local floor="" cls="" verdict=allow reason=""
    if [[ " $layers " == *" floor "* ]]; then
        rc=0; gate_floor_match "$(cat -- "$t/payload")" || rc=$?
        case "$rc" in 0) floor=hit ;; 1) floor=clear ;; *) floor=fault:policy ;; esac
    fi
    if [[ " $layers " == *" classifier "* ]]; then
        rc=0; gate_classify "$t/payload" "$GATE_FLEET_CONF" || rc=$?
        case "$rc" in 0) cls=clear ;; 3) cls=hit ;; *) cls="$GATE_FAULT" ;; esac
    fi
    if [[ -n "$floor" && "$floor" != clear ]]; then
        verdict=block; [[ "$floor" == hit ]] && reason=hit:floor || reason="$floor"
    fi
    if [[ -z "$reason" && -n "$cls" && "$cls" != clear ]]; then
        verdict=block; [[ "$cls" == hit ]] && reason=hit:classifier || reason="$cls"
    fi
    gate_result "$t" "$verdict" "$reason" \
        "$(jq -nc --arg f "$floor" --arg c "$cls" \
            '{layers: ((if $f == "" then {} else {floor: $f} end) + (if $c == "" then {} else {classifier: $c} end))}')"
}

# --- the connection ----------------------------------------------------------

gate_serve() { # gate_serve <confdir>
    local conf="$1" uid
    if ! gate_load "$conf"; then gate_answer block fault:config; return 0; fi
    gate_purge 2>/dev/null || true          # gate-owned purge on every connection
    uid="$(gate_peer_uid)" || uid=""
    GATE_Q_OP=unknown
    _gate_serve "$conf" "$uid"
    # One metadata-only query log line per hub-socket request; every block
    # counts toward the peer's probe budget.
    gate_query_log "$GATE_Q_OP" "$uid" "$GATE_LAST_VERDICT" "$GATE_LAST_REF"
    [[ "$GATE_LAST_VERDICT" == block && "$uid" =~ ^[0-9]+$ ]] && gate_rate_count_block "$uid"
    return 0
}

_gate_serve() { # _gate_serve <confdir> <peer uid>
    local conf="$1" uid="$2" t rc=0 verdict op reason payload=""
    if ! gate_peer_allowed "$uid"; then gate_block_record unknown fault:peer ""; return 0; fi
    # A peer over its request rate or block budget is a probe: blocked until its
    # window ends, logged for the operator, and notified (FR-14).
    if ! gate_rate_check "$uid"; then gate_block_record unknown probe ""; return 0; fi
    t="${RUNTIME_DIRECTORY:-}"
    [[ -n "$t" && -d "$t" ]] || t="$(mktemp -d)" || { gate_block_record unknown fault:internal ""; return 0; }
    chmod 700 "$t"
    rm -f "$t/result" "$t/timeout" "$t/payload"
    # The work keeps its stderr (journal); only the shell's own "Terminated"
    # notice for a stopped work group is dropped.
    { timeout -k 1 "$GATE_WORK_LIMIT" bash "$GATE_HANDLER" --work "$conf" "$t" <&0 2>&3; } 3>&2 2>/dev/null || rc=$?
    # Drain what is left of the request (bounded) before answering: closing a
    # socket with unread bytes resets it, and the client would lose the answer.
    timeout 1 head -c "$(( GATE_MAX_REQUEST + GATE_HEADER_MAX + 1 ))" > /dev/null 2>&1 <&0 || true
    if (( rc == 124 || rc == 137 )) || [[ -e "$t/timeout" ]]; then
        # eval and health blocks are never retained or logged, timeouts included.
        op="$(jq -r '.op // ""' "$t/header" 2>/dev/null)" || op=""
        if [[ "$op" == eval || "$op" == health ]]; then
            gate_answer block fault:timeout
        else
            gate_block_record unknown fault:timeout ""
        fi
    elif [[ -s "$t/result" ]] && jq -e '.verdict == "allow" or .verdict == "block"' "$t/result" >/dev/null 2>&1; then
        verdict="$(jq -r .verdict "$t/result")"; reason="$(jq -r .reason "$t/result")"
        op="$(jq -r '.op // "unknown"' "$t/result")"
        [[ "$(jq -r '.payload // false' "$t/result")" == true ]] && payload="$t/payload"
        if [[ "$verdict" == allow ]]; then
            gate_answer allow "$(jq -c .detail "$t/result")"
        elif [[ "$op" == eval || "$op" == health ]]; then
            gate_answer block "$reason" "$(jq -c .detail "$t/result")"
        else
            gate_block_record "$op" "$reason" "$payload"
        fi
    else
        op="$(jq -r '.op // ""' "$t/header" 2>/dev/null)" || op=""
        if [[ "$op" == eval || "$op" == health ]]; then
            gate_answer block fault:internal
        else
            gate_block_record unknown fault:internal ""
        fi
    fi
    GATE_Q_OP="$(gate_op_name "${op:-unknown}")"
    rm -f -- "$t/payload" "$t/header"
    [[ -z "${RUNTIME_DIRECTORY:-}" ]] && rm -rf -- "$t"
    return 0
}

gate_handler_main() {
    case "${1:-}" in
        --check-config)
            if gate_load "${2:-}"; then echo "  OK  gate config valid"; exit 0; fi
            echo " FAIL gate config invalid (deadlines must satisfy gate < shim < hook = 30 s, margins >= 2 s;"
            echo "      GATE_RETAIN_DAYS a whole number 1..30; store and quota bounds positive, quotas <= total)"
            exit 4 ;;
        --purge) gate_load "${2:-}" || exit 4; gate_purge; exit $? ;;
        --work) gate_work "${2:-}" "${3:-}" ;;
        /*) gate_serve "$1" ;;
        *) gate_answer block fault:config ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    gate_handler_main "$@"
fi
