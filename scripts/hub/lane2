#!/usr/bin/env bash
# lane2 — the hub command family (SP1a). This story (2.1) adds `lane2 install`;
# later stories add up, down, push, gh, review, policy, rescan, and health.
#
#   lane2 [--config-dir DIR] install <40-hex commit>
#   lane2 [--config-dir DIR] install --verify
#
# `lane2 install` deploys hub code from a MERGED commit (AD-18, FR-22, FR-52):
#   1. refuses inside a container, as non-root, for anything but a full commit
#      id, or for a local-path origin;
#   2. checks bash, jq, socat, systemd (and git, tar, flock) are present;
#   3. creates the service identities and the AD-7 stores (a store with the
#      wrong owner, group, or mode fails the install — never a silent chmod);
#   4. fetches the default branch from the configured origin into a hub-owned
#      bare clone and requires the commit to be reachable from it;
#   5. exports the commit's tree (git archive — never the invoking checkout or
#      any working tree) into <prefix>/<commit>/, root-owned, not writable by
#      anyone else;
#   6. renders and lints the units in scripts/hub/units/ from that tree;
#   7. swaps <prefix>/current atomically — every step before this one can fail
#      and leave the previous install running and `current` unchanged;
#   8. installs the units, enables only the boot allowlist (gate sockets, fleet
#      units, notifier), restarts installed services, records the installed-code
#      and gate-code digests, and prunes old installs beyond LANE2_KEEP_INSTALLS.
#
# `lane2 install --verify` recomputes both digests from <prefix>/current and
# checks the tree is still root-owned and not group- or world-writable.
#
# Config: <config-dir>/lane2.conf (default /etc/lane2), parsed, never sourced.
#   LANE2_ORIGIN          https:// or ssh:// URL of this repository (required)
#   LANE2_DEFAULT_BRANCH  default branch (main)
#   LANE2_OPERATOR        operator account (required)
#   LANE2_PREFIX          install prefix (/opt/lane2)
#   LANE2_STATE_ROOT      hub state root (/var/lib/lane2)
#   LANE2_UNIT_DIR        systemd system unit directory (/etc/systemd/system)
#   LANE2_KEEP_INSTALLS   commit directories kept, including current (3)
#
# Exit: 0 ok, 2 usage, 3 refused (unmerged or unknown commit), >=4 fault or
# refused for any other reason. Nothing changes on a non-zero exit before the swap.
set -euo pipefail

LANE2_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/lane2.sh
source "$LANE2_HERE/../lib/lane2.sh"
# shellcheck source=scripts/lib/gate.sh
source "$LANE2_HERE/../lib/gate.sh"
# shellcheck source=scripts/lib/gate-client.sh
source "$LANE2_HERE/../lib/gate-client.sh"
# shellcheck source=scripts/lib/lane2-image.sh
source "$LANE2_HERE/../lib/lane2-image.sh"

# file:// is refused for git; tests that source this script may relax it to
# fetch from a local bare fixture. A root run cannot change it.
LANE2_GIT_FILE_PROTOCOL=never

ok()   { printf '  OK  %s\n' "$1"; }
fail() { printf ' FAIL %s\n' "$1"; }
die()  { printf ' FAIL %s\n' "$2"; exit "$1"; }

lane2_git() {
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent LC_ALL=C \
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
        git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
            -c protocol.file.allow="$LANE2_GIT_FILE_PROTOCOL" "$@"
}

# --- settings ----------------------------------------------------------------

# Settings every command needs: who the operator is and where code and state live.
common_settings() {
    OPERATOR="$(lane2_conf LANE2_OPERATOR)"
    PREFIX="$(lane2_conf LANE2_PREFIX /opt/lane2)"
    STATE="$(lane2_conf LANE2_STATE_ROOT /var/lib/lane2)"
    UNIT_DIR="$(lane2_conf LANE2_UNIT_DIR /etc/systemd/system)"
    [[ -n "$OPERATOR" ]] || die 4 "LANE2_OPERATOR not set in hub config"
    local p home
    for p in "$PREFIX" "$STATE" "$UNIT_DIR"; do
        [[ "$p" == /* && "$p" != *..* ]] || die 4 "not an absolute path: $p"
    done
    home="$(getent passwd "$OPERATOR" | cut -d: -f6)" || die 4 "operator account $OPERATOR not found"
    for p in "$PREFIX" "$STATE"; do
        [[ -n "$home" && ( "$p" == "$home" || "$p" == "$home"/* ) ]] \
            && die 4 "$p is inside the operator's home; hub code and state live outside every workspace"
    done
    [[ "$PREFIX" == "$STATE" || "$PREFIX" == "$STATE"/* || "$STATE" == "$PREFIX"/* ]] \
        && die 4 "LANE2_PREFIX and LANE2_STATE_ROOT must not overlap"
    return 0
}

install_settings() {
    ORIGIN="$(lane2_conf LANE2_ORIGIN)"
    BRANCH="$(lane2_conf LANE2_DEFAULT_BRANCH main)"
    KEEP="$(lane2_conf LANE2_KEEP_INSTALLS 3)"
    [[ -n "$ORIGIN" ]] || die 4 "LANE2_ORIGIN not set in hub config"
    [[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ && "$BRANCH" != *..* ]] || die 4 "LANE2_DEFAULT_BRANCH is not a branch name"
    [[ "$KEEP" =~ ^[1-9][0-9]*$ ]] || die 4 "LANE2_KEEP_INSTALLS must be a positive integer"
}

install_tools() {
    local t missing=()
    for t in bash jq socat systemctl git tar sha256sum flock; do
        command -v "$t" >/dev/null 2>&1 || missing+=("$t")
    done
    if (( ${#missing[@]} > 0 )); then
        for t in "${missing[@]}"; do
            [[ "$t" == systemctl ]] && t="systemd (systemctl)"
            fail "required tool missing: $t"
        done
        exit 4
    fi
    ok "tools present: bash jq socat systemd git tar sha256sum flock"
}

install_identities() {
    local n
    for n in "${LANE2_SERVICE_IDENTITIES[@]}"; do
        lane2_ensure_identity "$n" || die 4 "cannot create service identity $n"
        lane2_check_identity "$n" || die 4 "service identity $n is not a non-root nologin account distinct from the operator"
    done
    ok "service identities: ${LANE2_SERVICE_IDENTITIES[*]}"
}

# --- fetch and export --------------------------------------------------------

install_fetch() { # install_fetch <commit>
    local commit="$1" bare="$STATE/install/origin.git"
    if [[ ! -d "$bare" ]]; then
        lane2_git init -q --bare "$bare" || die 4 "cannot create the hub bare clone"
    fi
    lane2_git -C "$bare" fetch -q --no-tags --prune "$ORIGIN" \
        "+refs/heads/$BRANCH:refs/heads/$BRANCH" 2>/dev/null \
        || die 4 "fetch from LANE2_ORIGIN failed"
    if ! lane2_git -C "$bare" cat-file -e "$commit^{commit}" 2>/dev/null; then
        fail "commit $commit is not on $BRANCH at the origin (unknown or unmerged)"
        exit 3
    fi
    if ! lane2_git -C "$bare" merge-base --is-ancestor "$commit" "refs/heads/$BRANCH"; then
        fail "commit $commit is not reachable from $BRANCH (unmerged)"
        exit 3
    fi
    ok "commit is on $BRANCH at the origin"
}

# Tree export from the bare clone only. Root-owned, nothing group/world-writable.
# Sets SRC_TREE (where to render from) and STAGE (empty when the commit is
# already installed, e.g. a rollback). install_place moves STAGE into place.
install_export() { # install_export <commit>
    local commit="$1" bare="$STATE/install/origin.git" dest want have
    dest="$PREFIX/$commit"; STAGE=""
    if [[ -d "$dest" ]]; then
        [[ -f "$dest/.lane2-install.json" ]] || die 4 "$dest exists without an install record; remove it by hand"
        want="$(jq -r .installed_code_digest "$dest/.lane2-install.json")"
        have="$(lane2_tree_digest "$dest")"
        [[ "$want" == "$have" ]] || die 4 "$dest does not match its install record; remove it by hand"
        SRC_TREE="$dest"
        ok "commit already installed at $dest; reusing it"
        return 0
    fi
    STAGE="$(mktemp -d "$PREFIX/.staging.XXXXXX")" || die 4 "cannot create a staging directory"
    trap 'rm -rf -- "$STAGE"' EXIT
    lane2_git -C "$bare" archive --format=tar "$commit" | tar -x --no-same-owner --no-same-permissions -C "$STAGE" \
        || die 4 "cannot export the commit tree"
    lane2_chown -R "$(lane2_uid root):$(lane2_gid root)" "$STAGE" || die 4 "cannot set owner of the install tree"
    chmod -R go-w "$STAGE"
    chmod 755 "$STAGE"
    jq -nc --arg commit "$commit" --arg digest "$(lane2_tree_digest "$STAGE")" \
        '{commit: $commit, installed_code_digest: $digest}' > "$STAGE/.lane2-install.json"
    chmod 644 "$STAGE/.lane2-install.json"
    SRC_TREE="$STAGE"
}

install_place() { # install_place <commit>
    [[ -n "$STAGE" ]] || return 0
    mv -T "$STAGE" "$PREFIX/$1" || die 4 "cannot move the install tree into place"
    trap - EXIT
    STAGE=""
    ok "tree installed at $PREFIX/$1"
}

# --- units -------------------------------------------------------------------

# install_render <commit> — render units from the installed tree into a fresh
# directory under the install store and lint them. Prints the directory.
install_render() {
    local commit="$1" src="$SRC_TREE/scripts/hub/units" out f name problems=""
    out="$STATE/install/units.new"
    rm -rf -- "$out"; mkdir -m 700 "$out"
    if [[ -d "$src" ]]; then
        for f in "$src"/*; do
            [[ -f "$f" ]] || continue
            name="${f##*/}"
            case "$name" in *.service|*.socket|*.timer) ;; *) continue ;; esac
            [[ "$name" =~ ^[a-z0-9][a-z0-9@._-]*\.(service|socket|timer)$ ]] \
                || { problems+="$name: unit name not allowed"$'\n'; continue; }
            sed -e "s|@LANE2_CODE@|$PREFIX/$commit|g" \
                -e "s|@LANE2_STATE@|$STATE|g" \
                -e "s|@LANE2_CONFIG@|$CONFDIR|g" "$f" > "$out/$name"
            problems+="$(lane2_lint_unit "$out/$name")"
            [[ -n "$problems" && "$problems" != *$'\n' ]] && problems+=$'\n'
        done
    fi
    if [[ -n "$problems" ]]; then
        while IFS= read -r f; do [[ -n "$f" ]] && fail "unit lint: $f"; done <<<"$problems"
        rm -rf -- "$out"
        exit 4
    fi
    ok "units rendered and linted: $(find "$out" -type f | wc -l | tr -d ' ')"
}

# install_units — copy rendered units into place, drop lane2 units no longer
# shipped, enable only the boot allowlist, restart what is installed.
install_units() {
    local new="$STATE/install/units.new" list="$STATE/install/units.list" f name
    local -a names=() old=()
    for f in "$new"/*; do [[ -f "$f" ]] && names+=("${f##*/}"); done
    [[ -f "$list" ]] && mapfile -t old < "$list"
    for name in "${old[@]}"; do
        printf '%s\n' "${names[@]}" | grep -qxF -- "$name" && continue
        systemctl disable --now "$name" >/dev/null 2>&1 || true
        rm -f -- "${UNIT_DIR:?}/$name"
    done
    for name in "${names[@]}"; do
        install -m 644 -o root -g root "$new/$name" "$UNIT_DIR/$name" 2>/dev/null \
            || cp -f -- "$new/$name" "$UNIT_DIR/$name"
    done
    printf '%s\n' "${names[@]}" > "$list.tmp" && mv -f "$list.tmp" "$list"
    rm -rf -- "$new"
    systemctl daemon-reload || { fail "systemctl daemon-reload failed"; return 4; }
    for name in "${names[@]}"; do
        if lane2_boot_allowed "$name"; then
            systemctl enable "$name" >/dev/null || { fail "cannot enable $name"; return 4; }
        fi
        [[ "$name" == *@* ]] || systemctl try-restart "$name" || true
    done
    ok "units installed: ${#names[@]}; boot-enabled only the allowlist"
}

# --- record, swap, prune -----------------------------------------------------

install_record() { # install_record <commit>
    local commit="$1" dir="$PREFIX/$1" pins="null" tmp gate pv
    [[ -f "$dir/scripts/hub/pin-manifest.json" ]] && pins="$(jq -c . "$dir/scripts/hub/pin-manifest.json")"
    gate="$(lane2_tree_digest "$dir" "${LANE2_GATE_CODE[@]}")"
    pv="$(policy_version_now "$gate" 2>/dev/null)" || pv=""
    tmp="$STATE/install/manifest.json.tmp"
    jq -n --arg commit "$commit" --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
          --arg code "$(lane2_tree_digest "$dir")" --arg gate "$gate" --arg pv "$pv" \
          --argjson pins "$pins" \
          --arg img "${LANE2_IMAGE_ID:-}" --arg cv "${LANE2_CLAUDE_VERSION:-}" \
          --arg cs "${LANE2_CLAUDE_SHA256:-}" --arg idg "${LANE2_INTEGRATION_DIGEST:-}" \
          '{commit: $commit, installed_at: $time, installed_code_digest: $code,
            gate_code_digest: $gate, policy_version: (if $pv == "" then null else $pv end),
            container: (if $img == "" then null else
                {image_id: $img, claude_version: $cv, claude_sha256: $cs, integration_digest: $idg} end),
            pins: $pins}' > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE/install/manifest.json"
    ok "recorded installed-code and gate-code digests in the pin manifest record"
    if [[ -n "$pv" ]]; then
        ok "policy_version computed (kept on the hub only)"
    else
        printf '  !!  policy_version not computed: %s\n' "${POLICY_MISSING:-an input is missing}"
    fi
}

# --- policy (story 2.2) ------------------------------------------------------

# policy_version_now <gate-code digest> — policy_version from the current
# policy checkout and fleet config. On a missing input, sets POLICY_MISSING to
# the input's name (never its value) and returns 4.
policy_version_now() {
    local gate="$1" pol="$STATE/gate-policy/current" fleet="$CONFDIR/fleet.conf" model sha build
    model="$(lane2_conf_file_get "$fleet" FLEET_CLASSIFIER_MODEL)"
    sha="$(lane2_conf_file_get "$fleet" FLEET_CLASSIFIER_SHA256 | tr 'A-F' 'a-f')"
    build="$(lane2_conf_file_get "$fleet" FLEET_RUNTIME_BUILD)"
    POLICY_MISSING=""
    [[ -r "$pol/term-list.txt" ]]      || POLICY_MISSING="term list (run lane2 policy update)"
    [[ -r "$pol/classifier-prompt.md" ]] || POLICY_MISSING="${POLICY_MISSING:-classifier prompt (run lane2 policy update)}"
    [[ -n "$model" ]] || POLICY_MISSING="${POLICY_MISSING:-FLEET_CLASSIFIER_MODEL in fleet.conf}"
    [[ -n "$sha" ]]   || POLICY_MISSING="${POLICY_MISSING:-FLEET_CLASSIFIER_SHA256 in fleet.conf}"
    [[ -n "$build" ]] || POLICY_MISSING="${POLICY_MISSING:-FLEET_RUNTIME_BUILD in fleet.conf}"
    [[ -n "$gate" ]]  || POLICY_MISSING="${POLICY_MISSING:-installed gate code (run lane2 install)}"
    [[ -z "$POLICY_MISSING" ]] || return 4
    gate_policy_version "$pol/term-list.txt" "$pol/classifier-prompt.md" "$model" "$sha" "$build" "$gate" \
        || { POLICY_MISSING="a malformed input (checksum, build tag, or digest)"; return 4; }
}

# Valid terms of a list, trimmed and lowercased, one per line, sorted unique.
policy_terms() {
    local line term
    [[ -r "$1" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        term="${line#"${line%%[![:space:]]*}"}"; term="${term%"${term##*[![:space:]]}"}"
        [[ -n "$term" && "$term" != \#* && ${#term} -ge $GATE_TERM_MIN_LEN ]] || continue
        printf '%s\n' "${term,,}"
    done < "$1" | LC_ALL=C sort -u
}

# Callers pass a jq expression in single quotes; its $names are jq variables.
policy_event() { # policy_event <jq-object-expression> [jq args...]
    local expr="$1"; shift
    ( umask 077
      jq -nc --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$@" "{time: \$time} + ($expr)" \
          >> "$STATE/events/policy.jsonl" )
}

# policy_validate <tree> — the staged policy tree. Prints one line per check;
# rc 4 on the first failing step. Never prints a term or a prompt line.
policy_validate() {
    local tree="$1" n f rel
    gate_terms_check "$tree/term-list.txt" \
        || { fail "validate: term-list.txt missing or unreadable"; return 4; }
    for n in "${GATE_REJECTED_LINES[@]}"; do
        printf '  !!  term-list line %s rejected (under %s characters); not used\n' "$n" "$GATE_TERM_MIN_LEN"
    done
    (( GATE_TERMS_VALID > 0 )) \
        || { fail "validate: term list has no usable entry ($GATE_TERMS_REJECTED rejected)"; return 4; }
    if ! [[ -s "$tree/classifier-prompt.md" ]] || ! grep -q '[^[:space:]]' "$tree/classifier-prompt.md"; then
        fail "validate: classifier-prompt.md missing or empty"; return 4
    fi
    local plain=0 unknown=0
    while IFS= read -r -d '' f; do
        rel="${f#"$tree"/}"
        case "$rel" in
            term-list.txt|classifier-prompt.md|README|README.md|.gitignore|.gitattributes) ;;
            fixtures/*.gpg|fixtures/*.age) ;;
            fixtures/*|*.jsonl|*.json|*.csv) plain=$((plain + 1)) ;;
            *) unknown=$((unknown + 1)) ;;
        esac
    done < <(find "$tree" \( -type f -o -type l \) -print0)
    (( plain == 0 )) || { fail "validate: $plain plaintext fixture file(s); fixtures must be encrypted (.gpg or .age)"; return 4; }
    (( unknown == 0 )) || { fail "validate: $unknown unexpected file(s) in the policy tree"; return 4; }
    ok "validated: $GATE_TERMS_VALID term(s), $GATE_TERMS_REJECTED rejected, prompt present"
}

cmd_policy() {
    [[ "${1:-}" == update && $# == 1 ]] || die 2 "usage: lane2 policy update"
    local repo branch store bare commit stage prev pv old_pv removed=0 rc=0
    repo="$(lane2_conf LANE2_POLICY_REPO)"
    branch="$(lane2_conf LANE2_POLICY_BRANCH main)"
    [[ -n "$repo" ]] || die 4 "LANE2_POLICY_REPO not set in hub config"
    lane2_check_policy_repo "$repo" \
        || die 4 "LANE2_POLICY_REPO must be an https://, ssh://, or user@host:path URL; local paths are refused"
    [[ "$branch" =~ ^[A-Za-z0-9._/-]+$ && "$branch" != *..* ]] || die 4 "LANE2_POLICY_BRANCH is not a branch name"
    store="$STATE/gate-policy"
    lane2_check_store "$STATE" gate-policy \
        || die 4 "gate policy store missing or with the wrong owner, group, or mode; run lane2 install first"

    echo "== lane2 policy update =="
    umask 027                  # files 0640 / dirs 0750, group = the store's (gate)
    exec 9>>"$store/.lock"
    flock -w 30 9 || die 4 "another policy update is running"

    # fetch: the operator's own git and SSH config, with hooks, fsmonitor and
    # submodules off. The bare clone is the only place the repo lands.
    bare="$store/repo.git"
    [[ -d "$bare" ]] || git init -q --bare "$bare" || die 4 "fetch: cannot create the policy clone"
    git -c core.hooksPath=/dev/null -c core.fsmonitor=false -c submodule.recurse=false \
        -c protocol.file.allow="$LANE2_GIT_FILE_PROTOCOL" -C "$bare" \
        fetch -q --no-tags --no-recurse-submodules "$repo" "+refs/heads/$branch:refs/heads/$branch" 2>/dev/null \
        || die 4 "fetch: the policy repository could not be fetched; previous policy kept"
    commit="$(git -C "$bare" rev-parse --verify -q "refs/heads/$branch^{commit}")" \
        || die 4 "fetch: branch $branch not found; previous policy kept"
    ok "fetched"

    # stage and validate
    mkdir -p "$store/trees"
    stage="$(mktemp -d "$store/trees/.staging.XXXXXX")" || die 4 "stage: cannot create a staging directory"
    trap 'rm -rf -- "$stage"' EXIT
    git -c core.hooksPath=/dev/null -C "$bare" archive --format=tar "$commit" | tar -x -C "$stage" \
        || die 4 "stage: cannot export the policy tree; previous policy kept"
    policy_validate "$stage" || { echo "previous policy kept"; exit 4; }

    # removed entries since the previous policy: a count, never the entries
    prev="$store/current/term-list.txt"
    if [[ -r "$prev" ]]; then
        removed="$(comm -23 <(policy_terms "$prev") <(policy_terms "$stage/term-list.txt") | wc -l | tr -d ' ')"
    fi
    old_pv="$(jq -r '.policy_version // ""' "$store/state.json" 2>/dev/null || true)"

    # swap
    if [[ -d "$store/trees/$commit" ]]; then
        rm -rf -- "$stage"
    else
        mv -T "$stage" "$store/trees/$commit" || die 4 "swap: cannot move the policy tree into place"
    fi
    trap - EXIT
    ln -sfn "trees/$commit" "$store/.current.new"
    mv -T "$store/.current.new" "$store/current" || die 4 "swap: cannot switch to the new policy"
    ok "new policy in force"

    # keep the current tree and the previous one (the removal-count snapshot)
    local keep_prev; keep_prev="$(jq -r '.commit // ""' "$store/state.json" 2>/dev/null || true)"
    local d
    for d in "$store"/trees/*; do
        [[ -d "$d" ]] || continue
        [[ "${d##*/}" == "$commit" || "${d##*/}" == "$keep_prev" ]] && continue
        rm -rf -- "$d"
    done

    # policy_version: computed now if every input is there
    pv="$(policy_version_now "$(lane2_tree_digest "$PREFIX/current" "${LANE2_GATE_CODE[@]}" 2>/dev/null)" 2>/dev/null)" || pv=""
    [[ -d "$PREFIX/current" ]] || pv=""
    jq -n --arg commit "$commit" --arg pv "$pv" --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
          --argjson terms "$GATE_TERMS_VALID" --argjson rejected "$GATE_TERMS_REJECTED" --argjson removed "$removed" \
          '{commit: $commit, updated_at: $time, policy_version: (if $pv == "" then null else $pv end),
            terms: $terms, rejected_short: $rejected, removed_since_previous: $removed}' > "$store/state.json.tmp"
    mv -f "$store/state.json.tmp" "$store/state.json"

    if (( GATE_TERMS_REJECTED > 0 )); then
        # shellcheck disable=SC2016  # $n is a jq variable
        policy_event '{event: "policy_terms_rejected", count: $n}' --argjson n "$GATE_TERMS_REJECTED"
    fi
    if [[ -n "$pv" && "$pv" != "$old_pv" ]]; then
        # shellcheck disable=SC2016  # $t $r $d are jq variables
        policy_event '{event: "policy", terms: $t, rejected: $r, removed: $d}' \
            --argjson t "$GATE_TERMS_VALID" --argjson r "$GATE_TERMS_REJECTED" --argjson d "$removed"
        ok "policy_version changed; event logged (counts only)"
    elif [[ -n "$pv" ]]; then
        ok "policy_version unchanged"
    else
        printf '  !!  policy_version not computed: %s\n' "${POLICY_MISSING:-the install or fleet config is missing}"
    fi
    ok "removed since previous policy: $removed"
    return "$rc"
}

install_swap() { # install_swap <commit>
    ln -sfn "$1" "$PREFIX/.current.new"
    mv -T "$PREFIX/.current.new" "$PREFIX/current"
    ok "current -> $1"
}

# Keep LANE2_KEEP_INSTALLS commit directories in total: current plus the most
# recently installed others. Current is never removed.
install_prune() {
    local cur d n=1
    cur="$(readlink "$PREFIX/current")"
    while read -r _ d; do
        [[ "$d" =~ ^[0-9a-f]{40}$ && "$d" != "$cur" ]] || continue
        n=$((n + 1))
        (( n <= KEEP )) && continue
        rm -rf -- "${PREFIX:?}/$d"
        ok "pruned old install $d"
    done < <(find "$PREFIX" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' | sort -rn)
}

# --- commands ----------------------------------------------------------------

cmd_install() {
    local commit="${1:-}"
    if [[ "$commit" == --verify ]]; then (( $# == 1 )) || die 2 "usage: lane2 install --verify"; cmd_verify; return; fi
    (( $# == 1 )) || die 2 "usage: lane2 install <40-hex commit> | --verify"
    [[ "$commit" =~ ^[0-9a-f]{40}$ ]] \
        || die 4 "give the full 40-hex commit id, not an abbreviation, branch, or tag"
    lane2_check_origin "$ORIGIN" \
        || die 4 "LANE2_ORIGIN must be an https:// or ssh:// URL; local paths are refused"

    echo "== lane2 install $commit =="
    install_tools
    install_identities
    lane2_ensure_stores "$STATE" || exit 4
    [[ -d "$PREFIX" ]] || { mkdir -m 755 "$PREFIX" && lane2_chown "$(lane2_uid root):$(lane2_gid root)" "$PREFIX"; } \
        || die 4 "cannot create the install prefix"
    [[ "$(stat -c '%u %a' "$PREFIX")" == "$(lane2_uid root) 755" ]] \
        || die 4 "install prefix must be root-owned, mode 0755: $PREFIX"
    [[ -d "$UNIT_DIR" ]] || die 4 "unit directory missing: $UNIT_DIR"

    exec 9>>"$STATE/install/.lock"
    flock -w 30 9 || die 4 "another lane2 install is running"

    install_fetch "$commit"
    install_export "$commit"
    install_render "$commit"
    # The Lane 2 image, built from the installed tree before anything swaps: a
    # failed build leaves the previous install and image in force.
    LANE2_IMAGE_ID=""
    if [[ -f "$SRC_TREE/scripts/hub/container/Dockerfile" ]]; then
        lane2_image_build "$SRC_TREE" "$STATE/install" || exit 4
    fi
    install_place "$commit"
    install_swap "$commit"
    install_units || exit 4
    install_record "$commit"
    install_prune
    ok "install complete; roll back by installing the earlier commit"
}

cmd_verify() {
    local rec commit dir want_code want_gate code gate bad rc=0
    rec="$STATE/install/manifest.json"
    [[ -f "$rec" ]] || die 4 "no install record: $rec"
    commit="$(jq -r .commit "$rec")"; want_code="$(jq -r .installed_code_digest "$rec")"
    want_gate="$(jq -r .gate_code_digest "$rec")"
    [[ "$(readlink "$PREFIX/current" 2>/dev/null)" == "$commit" ]] \
        || { fail "current does not point at the recorded commit $commit"; rc=4; }
    dir="$PREFIX/$commit"
    [[ -d "$dir" ]] || die 4 "installed tree missing: $dir"
    code="$(lane2_tree_digest "$dir")"
    gate="$(lane2_tree_digest "$dir" "${LANE2_GATE_CODE[@]}")"
    if [[ "$code" == "$want_code" ]]; then ok "installed-code digest matches"; else fail "installed-code digest mismatch"; rc=4; fi
    if [[ "$gate" == "$want_gate" ]]; then ok "gate-code digest matches"; else fail "gate-code digest mismatch"; rc=4; fi
    bad="$(find "$dir" \( -perm -g=w -o -perm -o=w \) ! -type l -print -quit)"
    [[ -z "$bad" ]] || { fail "group- or world-writable path in the install: ${bad#"$dir"/}"; rc=4; }
    bad="$(find "$dir" ! -uid "$(lane2_uid root)" -print -quit)"
    [[ -z "$bad" ]] || { fail "path not owned by root in the install: ${bad#"$dir"/}"; rc=4; }
    verify_image "$rec" || rc=4
    return "$rc"
}

# The Lane 2 image (story 3.1): present and pinned, the claude binary as recorded
# and at or above the floor, and userns-remap in effect. Health calls this too.
verify_image() { # verify_image <install record>
    local rec="$1" img sha v n rc=0
    local -a uids=()
    img="$(jq -r '.container.image_id // ""' "$rec")"
    [[ -n "$img" ]] || { printf '  !!  no Lane 2 image recorded (no container in the installed tree)\n'; return 0; }
    sha="$(jq -r '.container.claude_sha256 // ""' "$rec")"
    if lane2_image_check "$img"; then ok "Lane 2 image present: $img"; else fail "Lane 2 image $img missing or not the pinned digest"; return 4; fi
    if lane2_claude_digest_check "$img" "$sha"; then ok "claude binary matches its pin"; else fail "claude binary in image $img does not match its pin"; rc=4; fi
    v="$(lane2_claude_version_in "$img")"
    if [[ -n "$v" ]] && _lane2_ver_ge "$v" "$LANE2_CLAUDE_FLOOR"; then ok "claude --version $v >= $LANE2_CLAUDE_FLOOR"
    else fail "claude --version in image $img is below $LANE2_CLAUDE_FLOOR or unreadable"; rc=4; fi
    for n in "$OPERATOR" "${LANE2_SERVICE_IDENTITIES[@]}"; do
        uids+=("$(getent passwd "$n" | cut -d: -f3)")
    done
    if lane2_userns_verify "$img" "${uids[@]}"; then ok "userns-remap in effect; container root maps to an unprivileged range"
    else fail "userns-remap: $LANE2_USERNS_REASON"; rc=4; fi
    return "$rc"
}

# --- check (story 2.3) -------------------------------------------------------

# lane2 check [--layers floor,classifier] < text — ask the gate's eval op.
# Prints the verdict, the reason, and each layer's result; never a term.
# Exit 0 allow, 3 block, 4 a local fault (which is also a block).
cmd_check() {
    local layers="floor,classifier" sock dl hdr rc=0
    while (( $# )); do
        case "$1" in
            --layers) layers="${2:-}"; shift 2 || die 2 "usage: lane2 check [--layers floor,classifier]" ;;
            *) die 2 "usage: lane2 check [--layers floor,classifier] < text" ;;
        esac
    done
    [[ "$layers" =~ ^(floor|classifier)(,(floor|classifier))?$ ]] || die 2 "--layers takes floor, classifier, or both"
    sock="$(lane2_conf_file_get "$CONFDIR/gate.conf" GATE_HUB_SOCKET)"; sock="${sock:-/run/lane2/gate/hub.sock}"
    dl="$(lane2_conf_file_get "$CONFDIR/gate.conf" GATE_SHIM_TIMEOUT)"; dl="${dl:-28}"
    hdr="$(jq -nc --arg l "$layers" '{v: 1, op: "eval", layers: ($l | split(","))}')"
    gate_client "$sock" "$dl" "$hdr" || rc=$?
    if (( rc == 4 )); then fail "could not ask the gate (local fault); treat as block"; return 4; fi
    if (( rc == 0 )); then ok "allow"; else
        local why ref
        why="$(jq -r '.detail.reason // "no well-formed answer"' <<<"${GATE_CLIENT_RESPONSE:-null}" 2>/dev/null)" || why="no well-formed answer"
        ref="$(jq -r '.ref // empty' <<<"${GATE_CLIENT_RESPONSE:-null}" 2>/dev/null)" || ref=""
        fail "block: ${why:-no well-formed answer}${ref:+ (ref $ref)}"
    fi
    jq -r '.detail.layers // {} | to_entries[] | "      \(.key): \(.value)"' <<<"${GATE_CLIENT_RESPONSE:-null}" 2>/dev/null || true
    return "$rc"
}

lane2_main() {
    CONFDIR=/etc/lane2
    if [[ "${1:-}" == --config-dir ]]; then
        CONFDIR="${2:-}"; shift 2 || die 2 "usage: lane2 [--config-dir DIR] <command>"
        [[ "$CONFDIR" == /* ]] || die 2 "--config-dir must be an absolute path"
    fi
    local cmd="${1:-}"; shift || true

    lane2_in_container && die 4 "run on the hub"
    command -v jq >/dev/null || die 4 "required tool missing: jq"
    case "$cmd" in
        install) lane2_is_root || die 4 "lane2 install must run as root" ;;
        policy|check) ;;
        *) die 2 "usage: lane2 [--config-dir DIR] install <commit> | install --verify | policy update | check" ;;
    esac
    lane2_load_config "$CONFDIR/lane2.conf" || die 4 "hub config unreadable: $CONFDIR/lane2.conf"
    common_settings

    case "$cmd" in
        install) install_settings; cmd_install "$@" ;;
        policy)
            lane2_is_operator || die 4 "lane2 policy update must run as the operator ($OPERATOR)"
            cmd_policy "$@" ;;
        check) cmd_check "$@" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    lane2_main "$@"
fi
