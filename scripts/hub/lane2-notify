#!/usr/bin/env bash
# lane2-notify — desktop notifications for gate blocks and lane2 events
# (SP1a story 2.4; AD-4, FR-7). Runs as the operator's user unit
# (lane2-notify.service).
#
#   lane2-notify [--config-dir DIR]          follow the operator log and the
#                                            lane2 event logs
#   lane2-notify --stdin [--config-dir DIR]  read "O <line>" (operator log) or
#                                            "E <line>" (event log) from stdin
#
# Each notification is fixed text, the category, and the ref, markup-escaped.
# A hit on a container-origin op is critical and sent at once, never coalesced.
# Everything else is coalesced per session per LANE2_NOTIFY_COALESCE seconds
# (default 60). A malformed line is counted and skipped, never shown raw. The
# gate blocks whether or not this runs: it only reads the logs.
set -uo pipefail

N_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/lane2.sh
source "$N_HERE/../lib/lane2.sh"

N_REF_RE='^gr-[0-9a-f]{32}$'
N_MALFORMED=0
declare -A N_LAST=() N_PENDING=() N_LATEST=()
N_INTERVAL=60

notify_now() { date +%s; }

notify_escape() { # markup-escape for notify-send bodies
    local s="$1"
    # Quoted replacements: in bash 5.2 an unquoted & in one means the match.
    s="${s//&/"&amp;"}"; s="${s//</"&lt;"}"; s="${s//>/"&gt;"}"
    printf '%s' "$s"
}

notify_send() { # notify_send <urgency> <body>
    notify-send -a lane2 -u "$1" "lane2 gate" "$(notify_escape "$2")" 2>/dev/null || true
}

# Coalesce: at most one notification per key per interval; the rest are counted
# and summarised in the next one.
notify_coalesced() { # notify_coalesced <key> <body>
    local key="$1" body="$2" now last
    now="$(notify_now)"; last="${N_LAST[$key]:-0}"
    if (( now - last >= N_INTERVAL )); then
        local more="${N_PENDING[$key]:-0}"
        (( more > 0 )) && body="$body (+$more more)"
        notify_send normal "$body"
        N_LAST[$key]="$now"; N_PENDING[$key]=0; N_LATEST[$key]=""
    else
        N_PENDING[$key]=$(( ${N_PENDING[$key]:-0} + 1 )); N_LATEST[$key]="$body"
    fi
}

notify_flush() { # send pending summaries whose interval has passed
    local key now
    now="$(notify_now)"
    for key in "${!N_PENDING[@]}"; do
        (( ${N_PENDING[$key]:-0} > 0 )) || continue
        (( now - ${N_LAST[$key]:-0} >= N_INTERVAL )) || continue
        notify_send normal "${N_PENDING[$key]} more: ${N_LATEST[$key]}"
        N_LAST[$key]="$now"; N_PENDING[$key]=0; N_LATEST[$key]=""
    done
}

# notify_line <O|E> <json line>
notify_line() {
    local src="$1" line="$2" cat ref origin session ev
    if [[ "$src" == O ]]; then
        if ! jq -e 'type == "object"' <<<"$line" >/dev/null 2>&1; then N_MALFORMED=$((N_MALFORMED + 1)); return; fi
        cat="$(jq -r '.reason_category // ""' <<<"$line")"; ref="$(jq -r '.ref // ""' <<<"$line")"
        origin="$(jq -r '.origin // ""' <<<"$line")"; session="$(jq -r '.session // "hub"' <<<"$line")"
        if ! [[ "$cat" =~ ^(hit|fault):[a-z-]+$ && "$ref" =~ $N_REF_RE && "$origin" =~ ^(operator|container|hub)$ \
               && "$session" =~ ^[A-Za-z0-9_-]{1,64}$ ]]; then
            N_MALFORMED=$((N_MALFORMED + 1)); return
        fi
        if [[ "$cat" == hit:* && "$origin" == container ]]; then
            notify_send critical "blocked ($cat) · ref $ref"
        else
            notify_coalesced "session:$session" "blocked ($cat) · ref $ref"
        fi
    elif [[ "$src" == E ]]; then
        if ! jq -e 'type == "object"' <<<"$line" >/dev/null 2>&1; then N_MALFORMED=$((N_MALFORMED + 1)); return; fi
        ev="$(jq -r '.event // ""' <<<"$line")"
        [[ "$ev" =~ ^[a-z_]{1,40}$ ]] || { N_MALFORMED=$((N_MALFORMED + 1)); return; }
        notify_coalesced "events" "lane2 event: $ev"
    else
        N_MALFORMED=$((N_MALFORMED + 1))
    fi
}

notify_loop() { # reads "<src> <line>" from stdin; flushes when idle
    local rec
    while true; do
        if IFS= read -r -t 1 rec; then
            notify_line "${rec%% *}" "${rec#* }"
        else
            (( $? > 128 )) || break          # EOF (not a read timeout)
        fi
        notify_flush
    done
    notify_flush
    (( N_MALFORMED == 0 )) || printf '  !!  malformed log lines skipped: %s\n' "$N_MALFORMED" >&2
}

notify_main() {
    local conf=/etc/lane2 stdin=0 state oplog
    while (( $# )); do
        case "$1" in
            --stdin) stdin=1; shift ;;
            --config-dir) conf="${2:-}"; shift 2 || exit 2 ;;
            *) echo "usage: lane2-notify [--stdin] [--config-dir DIR]" >&2; exit 2 ;;
        esac
    done
    lane2_load_config "$conf/lane2.conf" || exit 4
    N_INTERVAL="$(lane2_conf LANE2_NOTIFY_COALESCE 60)"
    [[ "$N_INTERVAL" =~ ^[0-9]{1,5}$ ]] || exit 4
    if (( stdin )); then notify_loop; return; fi
    state="$(lane2_conf LANE2_STATE_ROOT /var/lib/lane2)"
    oplog="$state/operator-log/gate.jsonl"
    {
        tail -n 0 -F "$oplog" 2>/dev/null | sed -u 's/^/O /' &
        tail -n 0 -F "$state/events/policy.jsonl" 2>/dev/null | sed -u 's/^/E /' &
        wait
    } | notify_loop
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    notify_main "$@"
fi
