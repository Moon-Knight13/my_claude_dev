[Unit]
Description=lane2 gate handler (one hub-socket connection)

[Service]
User=lane2-gate
Group=lane2-gate
ExecStart=@LANE2_CODE@/scripts/hub/gate-handler @LANE2_CONFIG@
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeDirectory=lane2-gate/%i
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
# The only paths the gate writes: its store and the operator log (AD-7).
ReadWritePaths=@LANE2_STATE@/gate-store @LANE2_STATE@/operator-log
ProtectHome=yes
PrivateTmp=yes
LimitCORE=0
