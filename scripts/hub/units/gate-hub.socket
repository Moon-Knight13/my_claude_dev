[Unit]
Description=lane2 gate hub socket (SP1a; one handler per connection)

[Socket]
ListenStream=/run/lane2/gate/hub.sock
Accept=yes
# Any local process may connect; the handler answers block to every peer that
# is not the operator or a hub service identity (SO_PEERCRED).
SocketMode=0666
DirectoryMode=0755
MaxConnections=64
# Invalid GATE_ deadlines stop the gate from starting.
ExecStartPre=@LANE2_CODE@/scripts/hub/gate-handler --check-config @LANE2_CONFIG@

[Install]
WantedBy=sockets.target
