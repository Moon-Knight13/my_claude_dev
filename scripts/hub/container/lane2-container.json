{
  "version": 1,
  "image": "pinned-by-digest",
  "user": "node",
  "read_only": true,
  "tmpfs": [
    {"target": "/tmp", "options": "rw,noexec,nosuid,nodev,size=512m"},
    {"target": "/home/node", "options": "rw,nosuid,nodev,size=256m"}
  ],
  "cap_drop": ["ALL"],
  "cap_add": [],
  "security_opt": ["no-new-privileges"],
  "network": "none",
  "privileged": false,
  "pid": "private",
  "userns": "remap",
  "devices": [],
  "add_host": [],
  "env": {},
  "mounts": [
    {"kind": "workspace", "target": "/workspace", "mode": "rw"},
    {"kind": "host-executed", "target": "per-member", "mode": "ro"},
    {"kind": "integration-policy", "target": "/etc/claude-code", "mode": "ro"},
    {"kind": "agent-settings", "target": "/workspace/.claude", "mode": "ro"},
    {"kind": "session-sockets", "target": "/run/lane2", "mode": "ro"},
    {"kind": "claude-config", "target": "/home/node/.claude", "mode": "rw"}
  ]
}
