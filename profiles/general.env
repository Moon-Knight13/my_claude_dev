# Profile: general — Software Development
# Minimal profile. Dev mode only, no offensive tools.

# ── Profile metadata ─────────────────────────────────────────────────────────
ACTIVE_PROFILE=general
PROFILE_MODES=platform-ops

# ── MCP servers expected for this profile ─────────────────────────────────────
PROFILE_MCPS=obsidian-mcp

# ── No spoke connectivity ────────────────────────────────────────────────────
# General dev — no spokes, no range services.

# ── Obsidian vault ────────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=~/Documents/my_notes

# ── Local model (failover) ────────────────────────────────────────────────────
LOCAL_MODEL_ENABLED=false
