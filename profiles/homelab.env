# Profile: homelab — Homelab Infrastructure
# Local services, Ollama, no range connectivity.

# ── Profile metadata ─────────────────────────────────────────────────────────
ACTIVE_PROFILE=homelab
PROFILE_MODES=platform-ops

# ── MCP servers expected for this profile ─────────────────────────────────────
PROFILE_MCPS=local-ollama,obsidian-mcp

# ── No spoke connectivity ────────────────────────────────────────────────────
# Homelab services are local or on LAN — no SSH spokes needed.

# ── Obsidian vault ────────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=~/Documents/homelab_notes

# ── Local model (primary for homelab) ────────────────────────────────────────
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_MODEL_MODEL=qwen2.5-coder:7b
