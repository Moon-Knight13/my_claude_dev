# Profile: range — Cyber Range
# Full spoke connectivity, all range MCPs, offensive tooling enabled.

# ── Profile metadata ─────────────────────────────────────────────────────────
ACTIVE_PROFILE=range
PROFILE_MODES=platform-ops,green-dev,red-team,red-dev,purple,blue

# ── MCP servers expected for this profile ─────────────────────────────────────
# Used by switch-profile.sh to validate connectivity.
PROFILE_MCPS=range-intel,tuoni-mcp,outline-readonly,obsidian-mcp,hacktricks-mcp,mitre-mcp,cve-mcp,lolbins-mcp,nuclei-mcp,bloodhound-mcp,hashcat-mcp,rea-mcp

# ── Spoke connectivity ────────────────────────────────────────────────────────
# Fill these with your range-specific values in ~/.claude-profiles/range.env
HUB_SSH_USER=
SPOKE_DEPLOYBOX_HOST=
SPOKE_DEPLOYBOX_USER=gt
SPOKE_DEPLOYBOX_PORT=22
SPOKE_KALI_HOST=
SPOKE_KALI_USER=rt
SPOKE_KALI_SSH_PORT=22
SPOKE_KALI_C2_API_PORT=12702
SPOKE_KALI_C2_WEB_PORT=8443
SPOKE_KALI_SOCKS_PORT=1080

# ── Range services ────────────────────────────────────────────────────────────
RANGE_GIT_HOST=
RANGE_GIT_SSH_PORT=10022
RANGE_GIT_USER=git
PROVIDENTIA_HOST=
OUTLINE_HOST=

# ── Obsidian vault ────────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=~/Documents/my_notes

# ── Local model (failover) ────────────────────────────────────────────────────
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_ENDPOINT=http://host.docker.internal:11434
LOCAL_MODEL_MODEL=qwen2.5-coder:7b

# ── Credentials (fill per-install, never commit) ─────────────────────────────
TUONI_USERNAME=
TUONI_PASSWORD=
PROVIDENTIA_TOKEN=
GITLAB_TOKEN=
GITLAB_PROJECT=
OUTLINE_API_KEY=
MCP_PROXY_TOKEN=
BLOODHOUND_URI=bolt://localhost:7687
BLOODHOUND_USERNAME=neo4j
BLOODHOUND_PASSWORD=
