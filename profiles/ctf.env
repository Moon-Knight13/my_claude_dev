# Profile: ctf — CTF Platforms (HTB, THM, PG)
# No range spokes. CVE/technique research MCPs only.

# ── Profile metadata ─────────────────────────────────────────────────────────
ACTIVE_PROFILE=ctf
PROFILE_MODES=platform-ops,red-dev,red-team

# ── MCP servers expected for this profile ─────────────────────────────────────
PROFILE_MCPS=hacktricks-mcp,mitre-mcp,cve-mcp,lolbins-mcp,obsidian-mcp,rea-mcp

# ── No spoke connectivity ────────────────────────────────────────────────────
# CTF targets connect via VPN, not SSH spokes.
# HUB_SSH_USER, SPOKE_* are intentionally unset.

# ── Obsidian vault ────────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=~/Documents/ctf_notes

# ── Local model (failover) ────────────────────────────────────────────────────
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL_ENDPOINT=http://host.docker.internal:11434
LOCAL_MODEL_MODEL=qwen2.5-coder:7b
