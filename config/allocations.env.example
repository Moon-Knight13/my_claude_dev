# allocations.env — Current box allocations. Updated when boxes change.
# Copy to allocations.env and fill in. Sourced by check-tuoni-version.sh
# and setup-day0.sh. DO NOT commit the real file (gitignored).
#
# When a box is reallocated, update HERE — all scripts and MCP configs
# pick up the change. Single source of truth for tool endpoints.
#
# Providentia is authoritative for IP/host allocation (DEV-002).
# This file caches the current assignment for offline/automated use.

# ── Tuoni C2 server ─────────────────────────────────────────────────────
# The box running Tuoni. Changes between exercises/allocations.
TUONI_HOST=CHANGE-ME
TUONI_PORT=8443
TUONI_URL=https://${TUONI_HOST}:${TUONI_PORT}
TUONI_USERNAME=CHANGE-ME
TUONI_PASSWORD=CHANGE-ME
TUONI_TLS_VERIFY=false

# ── Kali / attack box ──────────────────────────────────────────────────
# Primary offensive tooling host. Tools run HERE, not on targets.
KALI_HOST=CHANGE-ME
KALI_USER=rt
KALI_SSH_PORT=22

# ── Deploy box (this machine if running locally) ───────────────────────
# DEPLOY_HOST=localhost

# ── Range identifier ───────────────────────────────────────────────────
# Which team range is active. Used by ctp-deploy-range safety lock.
ACTIVE_RANGE=CHANGE-ME
