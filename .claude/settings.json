{
  "_comment": "Base settings — always active regardless of mode. Hooks and guards live here. MCP servers are in .mcp-<mode>.json, selected at launch by start-mode.sh.",
  "_pii_shield_note": "PII-Shield (gregmos/PII-Shield) anonymizes content before it reaches Claude. Install manually: Settings > Extensions > drag in the .mcpb file. See docs/TEMPLATE_GUIDE.md#pii--privacy-controls for details.",
  "_statusline_note": "The caveman statusline badge is auto-configured by scripts/install-caveman.sh at container start into user-level settings (~/.claude/settings.json), because the plugin script lives at a hash-versioned cache path. Do not hardcode a statusLine here.",
  "_mcp_note": "MCP servers live in .mcp.json (Claude Code reads them from there, not here). This file is for hooks, permissions, and mode notes only.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/secret-scan.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/mode-inject.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/audit-trail.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/mode-tool-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/research-dispatch-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-provenance.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/dispatch-validation-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "CTP_AUTO_APPROVE_READONLY=1 $CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-ctp.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/skill-mode-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__t3-code__t3_thread_launch|mcp__t3-code__create_threads|mcp__t3-code__delegate_task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/remote-thread-approval-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/master-dispatch-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tuoni-secret-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/pretooluse-gitlab-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/homelab-leak-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/response-scanner.sh"
          }
        ]
      },
      {
        "matcher": "mcp__tuoni-mcp__tuoni_command_get",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auto-log-finding.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/commit-scope-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-end-audit.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-end-sync.sh"
          }
        ]
      }
    ]
  },
  "_mode_note": "Active mode is set at launch by scripts/start-mode.sh. See /mode for info.",
  "permissions": {
    "deny": [
      "Write(~/tuoni-live/config/**)",
      "Write(~/tuoni-live/ssl/**)",
      "Write(/srv/tuoni/config/**)",
      "Write(/srv/tuoni/ssl/**)",
      "Edit(~/tuoni-live/config/**)",
      "Edit(~/tuoni-live/ssl/**)",
      "Edit(/srv/tuoni/config/**)",
      "Edit(/srv/tuoni/ssl/**)"
    ],
    "allow": [
      "Read",
      "ToolSearch",
      "Bash(ls:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(realpath:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh search:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh api:*)",
      "Bash(gh repo list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ssh -o ConnectTimeout=5:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git stash list:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(curl -s:*)",
      "Bash(curl -sk:*)",
      "Bash(python3 -c:*)",
      "Bash(bash scripts/ctp-bridge.sh host list:*)",
      "Bash(bash scripts/ctp-bridge.sh host vars:*)",
      "Bash(bash scripts/ctp-bridge.sh project update-inventory:*)"
    ]
  }
}
