[Unit]
Description=Tuoni C2 Server
After=network.target

[Service]
Type=simple
User={{ tuoni_user }}
Group={{ tuoni_group }}
WorkingDirectory={{ tuoni_install_dir }}
ExecStart=/usr/bin/java -Xmx{{ tuoni_heap_size }} -jar {{ tuoni_install_dir }}/{{ tuoni_jar_name }}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
