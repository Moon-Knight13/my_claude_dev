# Ansible inventory — hub-to-spoke targeting
# Copy to inventory.ini and fill in real values.
# Never commit inventory.ini (gitignored — contains IPs).
# Secrets come from .env via env lookup — no vault needed.

[kali]
# kali-rt-dev ansible_host=<IP> ansible_user=rt

[kali:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args=-o ForwardAgent=yes
