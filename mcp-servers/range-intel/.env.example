# Range-Intel MCP — Configuration
# Copy to .env and fill in your values.
# .env is gitignored — tokens and paths never enter the repo or Claude sessions.

# Providentia
PROVIDENTIA_URL=
PROVIDENTIA_TOKEN=

# GitLab (repo containing VM READMEs)
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT=                          # namespace/path or numeric project ID
GITLAB_REF=main                          # branch to read from
GITLAB_VM_PATH=                          # path to VM directories (each has README.md)
GITLAB_VULN_PATH=                        # path to vuln roles directory
